---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header";
import Footer from "../components/Footer";
import ScheduleEvents from "../components/ScheduleEvents";
import CurrentBookBadge from "../components/CurrentBookBadge";
---

<Layout
  title="Schedule - College Station Computer Science"
  description="Join us for book clubs and algorithm meetups. Check out our upcoming events and community gatherings."
>
  <Header client:only="react" />

  <div class="min-h-screen bg-white dark:bg-zinc-900">
    <!-- Hero Section -->
    <div class="relative isolate overflow-hidden">
      <!-- Background Pattern -->
      <svg
        aria-hidden="true"
        class="absolute inset-0 -z-10 h-full w-full [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)] stroke-zinc-200 dark:stroke-zinc-800"
      >
        <defs>
          <pattern
            x="50%"
            y={-1}
            id="schedule-pattern"
            width={200}
            height={200}
            patternUnits="userSpaceOnUse"
          >
            <path d="M.5 200V.5H200" fill="none"></path>
          </pattern>
        </defs>
        <rect
          fill="url(#schedule-pattern)"
          width="100%"
          height="100%"
          stroke-width={0}></rect>
      </svg>

      <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
          <h1
            class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-6xl dark:text-white"
          >
            Event Schedule
          </h1>
          <p class="mt-6 text-lg leading-8 text-zinc-600 dark:text-zinc-400">
            Join us for weekly book clubs and bi-weekly algorithm meetups. All
            times are in Central Standard Time (CST).
          </p>
        </div>
      </div>
    </div>

    <!-- Events List (Dynamic) -->
    <div class="mx-auto max-w-7xl px-6 pb-24 lg:px-8">
      <div class="mx-auto max-w-2xl lg:max-w-none">
        <ScheduleEvents client:load />

        <!-- Recurring Schedule Info -->
        <div class="mt-16 grid gap-8 sm:grid-cols-2">
          <div
            class="rounded-xl bg-indigo-50 p-6 ring-1 ring-indigo-100 dark:bg-indigo-950/20 dark:ring-indigo-900/30"
          >
            <h3
              class="mb-2 text-lg font-semibold text-zinc-900 dark:text-white"
            >
              Book Club
            </h3>
            <p class="mb-4 text-sm text-zinc-600 dark:text-zinc-400">
              Every Saturday at 2:00 PM CST via Zoom
            </p>
            <CurrentBookBadge client:load />
            <a
              href="/book-club"
              class="mt-4 inline-block text-sm font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
            >
              Learn more about Book Club &rarr;
            </a>
          </div>

          <div
            class="rounded-xl bg-emerald-50 p-6 ring-1 ring-emerald-100 dark:bg-emerald-950/20 dark:ring-emerald-900/30"
          >
            <h3
              class="mb-2 text-lg font-semibold text-zinc-900 dark:text-white"
            >
              Algorithms Meetup
            </h3>
            <p class="mb-4 text-sm text-zinc-600 dark:text-zinc-400">
              Every other Saturday at 10:00 AM CST
            </p>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              Location: <span class="font-medium text-zinc-900 dark:text-white"
                >Capsher Technologies</span
              >
              <br />
              1604 Crescent Pointe Pkwy, College Station, TX 77845
            </p>
            <a
              href="https://www.meetup.com/college-station-computer-science/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-block text-sm font-semibold text-emerald-600 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300"
            >
              RSVP on Meetup.com &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>
