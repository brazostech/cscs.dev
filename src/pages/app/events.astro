---
import Layout from "../../layouts/Layout.astro";
import AppLayout from "../../components/AppLayout";

const title = "Events";
const description = "View and RSVP to upcoming events";
---

<Layout title={title} description={description}>
  <AppLayout client:only="react" currentPath="/app/events">
    <div class="space-y-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-zinc-900 dark:text-white">
            Events
          </h1>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
            View upcoming events and manage your RSVPs
          </p>
        </div>
        <a
          id="create-event-btn"
          href="/app/create-event"
          style="display: none;"
          class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-500"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"></path>
          </svg>
          Create Event
        </a>
      </div>

      <div id="events-container">
        <div class="py-12 text-center">
          <div
            class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-indigo-600 border-r-transparent dark:border-indigo-400"
          >
          </div>
          <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400">
            Loading events...
          </p>
        </div>
      </div>
    </div>
  </AppLayout>

  <script>
    import {
      pb,
      getEventRsvpCounts,
      getUserEventRsvps,
      rsvpToEvent,
      cancelRsvp,
    } from "../../lib/pocketbase";
    import type { RsvpData } from "../../lib/pocketbase";

    // Check if user is logged in
    const user = pb.authStore.model;
    if (!user) {
      window.location.href = "/login";
    }

    interface Event {
      id: string;
      title: string;
      description: string;
      date: string;
      time: string;
      time_zone: string;
      location: string;
      location_details?: string;
      type: string;
      tags: string;
      created: string;
      updated: string;
    }

    const isModerator = user?.role === "moderator";

    // Store RSVPs and counts for quick access
    let userRsvps: Record<string, RsvpData> = {};
    let rsvpCounts: Record<string, number> = {};

    async function loadEvents() {
      const container = document.getElementById("events-container");
      if (!container) return;

      try {
        // Fetch events from PocketBase
        const events = await pb.collection("events").getFullList<Event>({
          sort: "date",
        });

        if (events.length === 0) {
          container.innerHTML = `
            <div class="text-center py-12">
              <svg class="mx-auto h-12 w-12 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <h3 class="mt-2 text-sm font-semibold text-zinc-900 dark:text-white">No events</h3>
              <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">No events have been scheduled yet.</p>
            </div>
          `;
          return;
        }

        // Fetch RSVP data in parallel
        const eventIds = events.map((e) => e.id);
        [rsvpCounts, userRsvps] = await Promise.all([
          getEventRsvpCounts(eventIds),
          getUserEventRsvps(eventIds),
        ]);

        renderEvents(events);
      } catch (error) {
        console.error("Error loading events:", error);
        container.innerHTML = `
          <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <h3 class="mt-2 text-sm font-semibold text-zinc-900 dark:text-white">Error loading events</h3>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">${error instanceof Error ? error.message : "Failed to load events"}</p>
          </div>
        `;
      }
    }

    function renderEvents(events: Event[]) {
      const container = document.getElementById("events-container");
      if (!container) return;

      const eventsHTML = events.map((event) => {
        const eventDate = new Date(event.date);
        const formattedDate = eventDate.toLocaleDateString("en-US", {
          weekday: "short",
          year: "numeric",
          month: "short",
          day: "numeric",
        });

        const count = rsvpCounts[event.id] || 0;
        const userRsvp = userRsvps[event.id];
        const isAttending = !!userRsvp;

        // Attendee count badge
        const attendeesBadge = `
          <span class="inline-flex items-center gap-1 text-xs text-zinc-500 dark:text-zinc-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            ${count} attending
          </span>
        `;

        // RSVP button - changes based on attendance status
        const rsvpButton = isAttending
          ? `<button
              onclick="handleRsvp('${event.id}')"
              data-event-id="${event.id}"
              class="rsvp-btn inline-flex items-center rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-700/10 hover:bg-emerald-100 dark:bg-emerald-400/10 dark:text-emerald-400 dark:ring-emerald-400/30 dark:hover:bg-emerald-400/20 cursor-pointer"
            >
              Attending
            </button>`
          : `<button
              onclick="handleRsvp('${event.id}')"
              data-event-id="${event.id}"
              class="rsvp-btn inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10 hover:bg-indigo-100 dark:bg-indigo-400/10 dark:text-indigo-400 dark:ring-indigo-400/30 dark:hover:bg-indigo-400/20 cursor-pointer"
            >
              RSVP
            </button>`;

        // Moderator action buttons
        const moderatorButtons = isModerator
          ? `
          <a
            href="/app/create-event?edit=${event.id}"
            class="inline-flex items-center rounded-md bg-zinc-50 px-2 py-1 text-xs font-medium text-zinc-700 ring-1 ring-inset ring-zinc-700/10 hover:bg-zinc-100 dark:bg-zinc-400/10 dark:text-zinc-400 dark:ring-zinc-400/30 dark:hover:bg-zinc-400/20 cursor-pointer"
          >
            Edit
          </a>
          <button
            onclick="deleteEvent('${event.id}')"
            class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-700/10 hover:bg-red-100 dark:bg-red-400/10 dark:text-red-400 dark:ring-red-400/30 dark:hover:bg-red-400/20 cursor-pointer"
          >
            Delete
          </button>
        `
          : "";

        // Card view (mobile and tablet)
        const cardHTML = `
          <div class="lg:hidden rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4 space-y-3" data-event-card="${event.id}">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h3 class="text-sm font-medium text-zinc-900 dark:text-white">${event.title}</h3>
                <span class="inline-block mt-1 text-xs text-zinc-500 dark:text-zinc-400">${event.type}</span>
              </div>
            </div>
            <div class="space-y-1 text-sm">
              <div class="flex items-center gap-2 text-zinc-600 dark:text-zinc-300">
                <svg class="h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                ${formattedDate} at ${event.time} ${event.time_zone}
              </div>
              <div class="flex items-center gap-2 text-zinc-600 dark:text-zinc-300">
                <svg class="h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                ${event.location}${event.location_details ? ` - ${event.location_details}` : ""}
              </div>
            </div>
            <div class="flex items-center justify-between gap-2 pt-2 border-t border-zinc-100 dark:border-zinc-800">
              ${attendeesBadge}
              <div class="flex items-center gap-2">
                ${rsvpButton}
                ${moderatorButtons}
              </div>
            </div>
          </div>
        `;

        // Table row (desktop)
        const rowHTML = `
          <tr class="hidden lg:table-row" data-event-row="${event.id}">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div>
                  <div class="text-sm font-medium text-zinc-900 dark:text-white">${event.title}</div>
                  <div class="text-sm text-zinc-500 dark:text-zinc-400">${event.type}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-zinc-900 dark:text-white">${formattedDate}</div>
              <div class="text-sm text-zinc-500 dark:text-zinc-400">${event.time} ${event.time_zone}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-zinc-900 dark:text-white">${event.location}</div>
              ${event.location_details ? `<div class="text-sm text-zinc-500 dark:text-zinc-400">${event.location_details}</div>` : ""}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-center text-sm">
              <span class="attendee-count text-zinc-500 dark:text-zinc-400" data-count-for="${event.id}">${count}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <div class="flex items-center justify-end gap-2">
                ${rsvpButton}
                ${moderatorButtons}
              </div>
            </td>
          </tr>
        `;

        return { cardHTML, rowHTML };
      });

      const cardsHTML = eventsHTML.map((e) => e.cardHTML).join("");
      const rowsHTML = eventsHTML.map((e) => e.rowHTML).join("");

      container.innerHTML = `
        <!-- Card view (mobile and tablet) -->
        <div class="lg:hidden space-y-4">
          ${cardsHTML}
        </div>

        <!-- Desktop table view (lg and up) -->
        <div class="hidden lg:block overflow-x-auto rounded-lg border border-zinc-200 dark:border-zinc-800">
          <table class="min-w-full divide-y divide-zinc-200 dark:divide-zinc-800">
            <thead class="bg-zinc-50 dark:bg-zinc-900">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider dark:text-zinc-400">
                  Event
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider dark:text-zinc-400">
                  Date & Time
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider dark:text-zinc-400">
                  Location
                </th>
                <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-zinc-500 uppercase tracking-wider dark:text-zinc-400">
                  Attending
                </th>
                <th scope="col" class="relative px-6 py-3">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-zinc-200 dark:bg-zinc-900 dark:divide-zinc-800">
              ${rowsHTML}
            </tbody>
          </table>
        </div>
      `;
    }

    // Handle RSVP toggle
    (window as any).handleRsvp = async function (eventId: string) {
      const buttons = document.querySelectorAll(
        `button.rsvp-btn[data-event-id="${eventId}"]`,
      );
      const userRsvp = userRsvps[eventId];

      // Disable buttons during operation
      buttons.forEach((btn) => btn.setAttribute("disabled", "true"));

      try {
        if (userRsvp) {
          // Cancel RSVP
          await cancelRsvp(userRsvp.id);
          delete userRsvps[eventId];
          rsvpCounts[eventId] = Math.max(0, (rsvpCounts[eventId] || 1) - 1);
        } else {
          // Create RSVP
          const newRsvp = await rsvpToEvent(eventId);
          userRsvps[eventId] = newRsvp;
          rsvpCounts[eventId] = (rsvpCounts[eventId] || 0) + 1;
        }

        // Update UI for this event
        updateEventUI(eventId);
      } catch (error) {
        console.error("Error updating RSVP:", error);
        alert(
          "Failed to update RSVP: " +
            (error instanceof Error ? error.message : "Unknown error"),
        );
      } finally {
        buttons.forEach((btn) => btn.removeAttribute("disabled"));
      }
    };

    // Update UI for a single event after RSVP change
    function updateEventUI(eventId: string) {
      const count = rsvpCounts[eventId] || 0;
      const isAttending = !!userRsvps[eventId];

      // Update all RSVP buttons for this event
      const buttons = document.querySelectorAll(
        `button.rsvp-btn[data-event-id="${eventId}"]`,
      );
      buttons.forEach((btn) => {
        if (isAttending) {
          btn.textContent = "Attending";
          btn.className =
            "rsvp-btn inline-flex items-center rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-700/10 hover:bg-emerald-100 dark:bg-emerald-400/10 dark:text-emerald-400 dark:ring-emerald-400/30 dark:hover:bg-emerald-400/20 cursor-pointer";
        } else {
          btn.textContent = "RSVP";
          btn.className =
            "rsvp-btn inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10 hover:bg-indigo-100 dark:bg-indigo-400/10 dark:text-indigo-400 dark:ring-indigo-400/30 dark:hover:bg-indigo-400/20 cursor-pointer";
        }
      });

      // Update attendee count in table
      const countSpans = document.querySelectorAll(
        `span[data-count-for="${eventId}"]`,
      );
      countSpans.forEach((span) => {
        span.textContent = count.toString();
      });

      // Update attendee count in cards (find the card and update the badge)
      const card = document.querySelector(`div[data-event-card="${eventId}"]`);
      if (card) {
        const badge = card.querySelector(".text-xs.text-zinc-500");
        if (badge && badge.textContent?.includes("attending")) {
          badge.innerHTML = `
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            ${count} attending
          `;
        }
      }
    }

    // Make delete function global for onclick handler
    (window as any).deleteEvent = async function (eventId: string) {
      if (!confirm("Are you sure you want to delete this event?")) {
        return;
      }

      try {
        await pb.collection("events").delete(eventId);
        loadEvents(); // Reload the list
      } catch (error) {
        console.error("Error deleting event:", error);
        alert(
          "Failed to delete event: " +
            (error instanceof Error ? error.message : "Unknown error"),
        );
      }
    };

    // Wait for container to be available before loading events
    function waitForContainer() {
      const container = document.getElementById("events-container");
      const createBtn = document.getElementById("create-event-btn");

      if (container && createBtn) {
        // Show Create Event button for moderators
        if (isModerator) {
          createBtn.style.display = "inline-flex";
        }

        loadEvents();
      } else {
        setTimeout(waitForContainer, 50);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", waitForContainer);
    } else {
      waitForContainer();
    }
  </script>
</Layout>
